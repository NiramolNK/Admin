# Stale git lock files parked here when they can't be unlinked directly.
_to_delete/

# Never commit a key or certificate. These patterns are here so a stray file
# cannot be added by accident — gitleaks catches the content, this catches the
# file before it is even staged.
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Vercel's local link file — project and org ids, not secret, but not ours to
# share and it changes per machine.
.vercel
